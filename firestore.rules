rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for TeamRoom
    function isValidTeamRoom(data) {
      return data.keys().hasAll(['roomCode', 'eventName', 'createdAt', 'createdBy']) &&
             data.roomCode is string && data.roomCode.size() > 0 && data.roomCode.size() <= 64 &&
             data.eventName is string && data.eventName.size() > 0 && data.eventName.size() <= 128 &&
             data.createdAt is number &&
             data.createdBy is string && data.createdBy.size() > 0 && data.createdBy.size() <= 128;
    }

    // Validation for TeamProfile
    function isValidTeamProfile(data) {
      return data.keys().hasAll(['teamNumber', 'updatedAt']) &&
             data.teamNumber is number && data.teamNumber > 0 && data.teamNumber < 100000 &&
             data.updatedAt is number &&
             (!('teamName' in data) || (data.teamName is string && data.teamName.size() <= 128)) &&
             (!('organization' in data) || (data.organization is string && data.organization.size() <= 128)) &&
             (!('location' in data) || (data.location is string && data.location.size() <= 128)) &&
             (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128));
    }

    // Validation for MatchRecord
    function isValidMatchRecord(data) {
      return data.keys().hasAll(['id', 'matchNumber', 'teamNumber', 'matchType', 'alliance', 'timestamp']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.matchNumber is number && data.matchNumber > 0 && data.matchNumber < 1000 &&
             data.teamNumber is number && data.teamNumber > 0 && data.teamNumber < 100000 &&
             data.matchType in ['Qualification', 'Playoff', 'Practice'] &&
             data.alliance in ['RED', 'BLUE'] &&
             data.timestamp is number &&
             (!('scoutName' in data) || (data.scoutName is string && data.scoutName.size() <= 64)) &&
             (!('scoutUid' in data) || (data.scoutUid is string && data.scoutUid.size() <= 128));
    }

    // Validation for StrategyBoard
    function isValidStrategyBoard(data) {
      return data.keys().hasAll(['id', 'updatedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.updatedAt is number &&
             (!('title' in data) || (data.title is string && data.title.size() <= 128)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 5000)) &&
             (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128));
    }

    // --- SCOUTING ROOMS ---
    match /rooms/{roomCode} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(roomCode) && isValidTeamRoom(incoming());
      allow update: if isSignedIn() && isValidId(roomCode) && isValidTeamRoom(incoming());
      allow delete: if isSignedIn() && isValidId(roomCode);

      // --- TEAMS IN ROOM ---
      match /teams/{teamNumber} {
        allow get, list: if isSignedIn();
        allow create, update: if isSignedIn() && isValidTeamProfile(incoming());
        allow delete: if isSignedIn();
      }

      // --- MATCHES IN ROOM ---
      match /matches/{matchId} {
        allow get, list: if isSignedIn();
        allow create, update: if isSignedIn() && isValidId(matchId) && isValidMatchRecord(incoming());
        allow delete: if isSignedIn() && isValidId(matchId);
      }

      // --- STRATEGIES IN ROOM ---
      match /strategies/{strategyId} {
        allow get, list: if isSignedIn();
        allow create, update: if isSignedIn() && isValidId(strategyId) && isValidStrategyBoard(incoming());
        allow delete: if isSignedIn() && isValidId(strategyId);
      }
    }
  }
}
