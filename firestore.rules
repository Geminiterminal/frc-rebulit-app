rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Validation for TeamRoom
    function isValidTeamRoom(data) {
      return data.keys().hasAll(['roomCode', 'eventName', 'createdAt']) &&
             data.roomCode is string && data.roomCode.size() > 0 && data.roomCode.size() <= 64 &&
             data.eventName is string && data.eventName.size() > 0 && data.eventName.size() <= 128 &&
             data.createdAt is number;
    }

    // Validation for TeamProfile
    function isValidTeamProfile(data) {
      return data.keys().hasAll(['teamNumber', 'updatedAt']) &&
             data.teamNumber is number && data.teamNumber > 0 && data.teamNumber < 100000 &&
             data.updatedAt is number;
    }

    // Validation for MatchRecord
    function isValidMatchRecord(data) {
      return data.keys().hasAll(['id', 'matchNumber', 'teamNumber', 'timestamp']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.matchNumber is number && data.matchNumber > 0 && data.matchNumber < 1000 &&
             data.teamNumber is number && data.teamNumber > 0 && data.teamNumber < 100000 &&
             data.timestamp is number;
    }

    // Validation for StrategyBoard
    function isValidStrategyBoard(data) {
      return data.keys().hasAll(['id', 'updatedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.updatedAt is number;
    }

    // --- P2P ACTIVE ROOMS REGISTRY ---
    match /p2p_rooms/{roomCode} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(roomCode);
    }

    // --- SCOUTING ROOMS ---
    match /rooms/{roomCode} {
      allow get: if isValidId(roomCode);
      allow list: if true; // Allows searching and listing active team rooms
      allow create, update: if isValidId(roomCode) && isValidTeamRoom(incoming());
      allow delete: if isValidId(roomCode);

      // --- TEAMS IN ROOM ---
      match /teams/{teamNumber} {
        allow get, list: if isValidId(roomCode);
        allow create, update: if isValidId(roomCode) && isValidTeamProfile(incoming());
        allow delete: if isValidId(roomCode);
      }

      // --- MATCHES IN ROOM ---
      match /matches/{matchId} {
        allow get, list: if isValidId(roomCode);
        allow create, update: if isValidId(roomCode) && isValidId(matchId) && isValidMatchRecord(incoming());
        allow delete: if isValidId(roomCode) && isValidId(matchId);
      }

      // --- STRATEGIES IN ROOM ---
      match /strategies/{strategyId} {
        allow get, list: if isValidId(roomCode);
        allow create, update: if isValidId(roomCode) && isValidId(strategyId) && isValidStrategyBoard(incoming());
        allow delete: if isValidId(roomCode) && isValidId(strategyId);
      }
    }
  }
}
